# Copy this file to .env and replace placeholders locally.
# Never commit .env or real credentials.

YTF_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1

# Generate a local value with:
# python -c "import secrets; print(secrets.token_hex(32))"
YTF_SECRET_KEY=<generate-a-local-secret>

# Role-specific database credentials. Replace placeholders locally.
# Never commit real values.
# Web application user; core schema only.
YTF_APP_DATABASE_URL=mysql+pymysql://ytf_app:<app_password>@<host>:<port>/yottaflex?charset=utf8mb4
# Risk engine user; core schema only. Never give this process the eval URL.
YTF_RISK_DATABASE_URL=mysql+pymysql://ytf_risk:<risk_password>@<host>:<port>/yottaflex?charset=utf8mb4
# Evaluation ground-truth user; evaluation schema only.
YTF_EVAL_DATABASE_URL=mysql+pymysql://ytf_eval:<eval_password>@<host>:<port>/yottaflex_eval?charset=utf8mb4
# Evaluation core-results user; read-only core access. Keep separate from YTF_EVAL_DATABASE_URL.
YTF_EVAL_CORE_DATABASE_URL=mysql+pymysql://ytf_eval_core:<eval_core_password>@<host>:<port>/yottaflex?charset=utf8mb4
# Synthetic generator user.
YTF_GENERATOR_DATABASE_URL=mysql+pymysql://ytf_generator:<generator_password>@<host>:<port>/yottaflex?charset=utf8mb4
# Dedicated migration user. Used only by migration commands.
YTF_MIGRATION_DATABASE_URL=mysql+pymysql://ytf_migrator:<migration_password>@<host>:<port>/yottaflex?charset=utf8mb4
YTF_EVAL_MIGRATION_DATABASE_URL=mysql+pymysql://ytf_migrator:<migration_password>@<host>:<port>/yottaflex_eval?charset=utf8mb4

# Dataset and risk defaults.
YTF_SEED=20261022
YTF_ALERT_THRESHOLD=40
YTF_DATA_REFERENCE_UTC=2026-10-30T00:00:00+00:00
